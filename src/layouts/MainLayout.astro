---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Ammar Asmro personal website"
} = Astro.props;

const navItems = [
  { href: "/", label: "Home" },
  { href: "/about/", label: "About" },
  { href: "/projects/", label: "Projects" }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/images/headshot.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        --bg: #f4efe6;
        --bg-strong: #eadcc7;
        --surface: rgba(255, 252, 247, 0.82);
        --surface-strong: rgba(255, 249, 242, 0.94);
        --text: #1f2430;
        --muted: #5f6776;
        --line: rgba(31, 36, 48, 0.12);
        --accent: #126b52;
        --accent-2: #d06c3f;
        --shadow: 0 20px 60px rgba(48, 36, 17, 0.12);
        --radius: 24px;
        --radius-sm: 16px;
        --max: 1160px;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        color: var(--text);
        background:
          radial-gradient(circle at top left, rgba(208, 108, 63, 0.18), transparent 30%),
          radial-gradient(circle at 85% 15%, rgba(18, 107, 82, 0.16), transparent 24%),
          linear-gradient(180deg, #f7f1e8 0%, #f3ede3 55%, #efe6d9 100%);
        font-family: "IBM Plex Sans", sans-serif;
        line-height: 1.6;
      }

      body::before {
        content: "";
        position: fixed;
        inset: 0;
        background-image:
          linear-gradient(rgba(31, 36, 48, 0.03) 1px, transparent 1px),
          linear-gradient(90deg, rgba(31, 36, 48, 0.03) 1px, transparent 1px);
        background-size: 28px 28px;
        pointer-events: none;
        mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.45), transparent 85%);
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      img {
        max-width: 100%;
        display: block;
      }

      .shell {
        width: min(calc(100% - 2rem), var(--max));
        margin: 0 auto;
        position: relative;
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 20;
        backdrop-filter: blur(16px);
        background: rgba(244, 239, 230, 0.72);
        border-bottom: 1px solid rgba(31, 36, 48, 0.08);
      }

      .site-header .shell {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1rem 0;
      }

      .brand {
        font-family: "Space Grotesk", sans-serif;
        font-size: 1rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }

      .nav {
        display: flex;
        gap: 0.55rem;
        flex-wrap: wrap;
        justify-content: flex-end;
      }

      .nav a {
        padding: 0.72rem 1rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.5);
        border: 1px solid rgba(31, 36, 48, 0.08);
        font-size: 0.95rem;
        transition: transform 180ms ease, background 180ms ease, border-color 180ms ease;
      }

      .nav a:hover {
        transform: translateY(-1px);
        background: rgba(255, 255, 255, 0.78);
        border-color: rgba(18, 107, 82, 0.25);
      }

      main {
        padding: 2.5rem 0 4rem;
      }

      .section {
        margin-top: 2rem;
      }

      .eyebrow {
        color: var(--accent);
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      h1,
      h2,
      h3 {
        font-family: "Space Grotesk", sans-serif;
        line-height: 1.06;
        margin: 0;
      }

      h1 {
        font-size: clamp(3rem, 7vw, 6rem);
        letter-spacing: -0.05em;
      }

      h2 {
        font-size: clamp(2rem, 4vw, 3rem);
        letter-spacing: -0.04em;
      }

      h3 {
        font-size: 1.3rem;
        letter-spacing: -0.03em;
      }

      p {
        margin: 0;
        color: var(--muted);
      }

      .lead {
        font-size: 1.08rem;
        max-width: 62ch;
      }

      .card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
      }

      .button-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.8rem;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        min-height: 3rem;
        padding: 0.9rem 1.2rem;
        border-radius: 999px;
        border: 1px solid transparent;
        font-weight: 600;
        transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
      }

      .button.primary {
        color: #f6f7f2;
        background: linear-gradient(135deg, var(--accent), #0d5b46);
        box-shadow: 0 14px 30px rgba(18, 107, 82, 0.18);
      }

      .button.secondary {
        background: rgba(255, 255, 255, 0.55);
        border-color: rgba(31, 36, 48, 0.1);
      }

      .button:hover {
        transform: translateY(-2px);
      }

      .chip-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
      }

      .chip {
        padding: 0.5rem 0.8rem;
        border-radius: 999px;
        background: rgba(18, 107, 82, 0.08);
        color: var(--accent);
        border: 1px solid rgba(18, 107, 82, 0.12);
        font-size: 0.9rem;
        font-weight: 600;
      }

      .site-footer {
        padding: 0 0 3rem;
      }

      .site-footer .card {
        padding: 1.25rem 1.4rem;
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        align-items: center;
      }

      .muted {
        color: var(--muted);
      }

      @media (max-width: 720px) {
        .site-header {
          position: static;
        }

        .site-header .shell,
        .site-footer .card {
          align-items: flex-start;
          flex-direction: column;
        }

        main {
          padding-top: 1.4rem;
        }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="shell">
        <a class="brand" href="/">Ammar Asmro</a>
        <nav class="nav" aria-label="Primary">
          {navItems.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main class="shell">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell">
        <div class="card">
          <p>Built with Astro and deployed on GitHub Pages.</p>
          <p class="muted">(c) {new Date().getFullYear()} Ammar Asmro</p>
        </div>
      </div>
    </footer>
  </body>
</html>
